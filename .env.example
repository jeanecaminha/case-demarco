# Copie para .env e preencha. Variáveis de ambiente reais têm precedência.

# --- BigQuery ---
GCP_PROJECT_ID=seu-projeto-gcp
BQ_LOCATION=US
# BQ_DATASET_RAW=rh_raw
# BQ_DATASET_STAGING=rh_staging
# BQ_DATASET_MARTS=rh_marts

# Chave JSON da service account (BigQuery Data Editor + BigQuery Job User).
# A mesma service account precisa ser Editora da planilha no Google Sheets.
GOOGLE_APPLICATION_CREDENTIALS=C:/caminho/para/service_account.json

# --- Google Sheets (planilha dos gestores importada do template) ---
# ID = trecho da URL entre /d/ e /edit
GSHEETS_SPREADSHEET_ID=
# Opcional: nome da aba (padrão = primeira aba)
# GSHEETS_WORKSHEET=

# --- Regras de negócio ---
PERIODO_INICIO=2025-06-01
PERIODO_FIM=2025-08-31
TOLERANCIA_MINUTOS=10
SALARIO_MINIMO=1518
